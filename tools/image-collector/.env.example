# Optional. When set, Pexels/Unsplash official APIs are used before public page metadata.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional HTTP identity. Wikimedia asks clients to identify themselves.
IMAGE_COLLECTOR_USER_AGENT=ConcertLabDatasetCollector/1.0 (local dataset tool)

# Optional overrides.
# DATASET_ROOT=C:\path\to\dataset
# HOST=127.0.0.1
# PORT=3000
# MAX_IMAGE_BYTES=26214400
# MAX_HTML_BYTES=5242880
# PREVIEW_TTL_MS=1800000
# REQUEST_TIMEOUT_MS=20000
# LOG_LEVEL=info
